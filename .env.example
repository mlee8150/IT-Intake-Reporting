# Copy to .env and fill in. Never commit the real .env file.

# --- Jira ---
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@your-company.com
JIRA_API_TOKEN=
# JQL used to pull the active parent-request population for panels 5-6 and
# to validate panel 1's closing balance. Adjust to your project/issue type.
JIRA_JQL_ACTIVE_REQUESTS=project = ITINTAKE AND issuetype = "Parent Request" AND statusCategory != Done

# Custom field IDs from your Jira instance (Settings > Issues > Custom fields,
# or GET /rest/api/3/field to list every field's id). Not guessable — see
# docs/OPEN_QUESTIONS.md.
JIRA_FIELD_DEPARTMENT=customfield_XXXXX
JIRA_FIELD_REVIEW_TEAM=customfield_XXXXX
JIRA_FIELD_EXEC_CRITICAL=customfield_XXXXX

# --- Outlook mailbox (COM backend) ---
# Display name of the shared mailbox as it appears in Outlook's folder pane,
# and the folder within it that receives the Jira "issue transitioned" emails.
OUTLOOK_SHARED_MAILBOX_NAME=IT Intake Notifications
OUTLOOK_TRANSITIONS_FOLDER=Inbox/Jira Transitions

# --- Paths ---
DEPARTMENT_MAPPING_CSV=config/department_mapping.csv
ROLLING_HISTORY_XLSX=config/rolling_history.xlsx
DECK_TEMPLATE_PPTX=templates/Technology_Intake_Weekly_Exec_Summary.pptx
DECK_OUTPUT_DIR=output
