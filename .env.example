# Copy to .env and fill in. Never commit the real .env file.

# --- Jira ---
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@your-company.com
JIRA_API_TOKEN=
# JQL used to pull the active parent-request population for panel 6 and to
# validate panel 1's closing balance. Adjust to your project/issue type.
JIRA_JQL_ACTIVE_REQUESTS=project = ITINTAKE AND issuetype = "Parent Request" AND statusCategory != Done

# JQL for panel 5 (demand by function) — deliberately lifetime volume (every
# parent request ever created), not just active ones. No statusCategory
# filter. May switch to active-only later — see docs/OPEN_QUESTIONS.md.
JIRA_JQL_LIFETIME_REQUESTS=project = ITINTAKE AND issuetype = "Parent Request"

# Custom field IDs from your Jira instance (Settings > Issues > Custom fields,
# or GET /rest/api/3/field to list every field's id). Not guessable — see
# docs/OPEN_QUESTIONS.md. (Review team is not a custom field — it's parsed
# from the sub-task's own name, e.g. "Legal review Sub-task".)
JIRA_FIELD_DEPARTMENT=customfield_XXXXX
JIRA_FIELD_EXEC_CRITICAL=customfield_XXXXX

# --- Outlook mailbox (COM backend) ---
# Display name of the shared mailbox as it appears in Outlook's folder pane,
# and the folder within it that receives the Jira "issue transitioned" emails.
OUTLOOK_SHARED_MAILBOX_NAME=IT Intake Notifications
OUTLOOK_TRANSITIONS_FOLDER=Inbox/Jira Transitions

# --- Paths ---
DEPARTMENT_MAPPING_CSV=config/department_mapping.csv
ROLLING_HISTORY_XLSX=config/rolling_history.xlsx
# Our own persisted record of each open sub-task's latest known transition —
# see history/subtask_transition_store.py. Not a re-derivable cache: it's
# what makes a sub-task stalled longer than one mailbox fetch window still
# visible to panels 3 and 7.
SUBTASK_TRANSITION_STORE_XLSX=config/subtask_transitions.xlsx
DECK_TEMPLATE_PPTX=templates/Technology_Intake_Weekly_Exec_Summary.pptx
DECK_OUTPUT_DIR=output
